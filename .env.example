# Django Settings
# Generate a new secret key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000

# Database
# For local development with PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/django_saas_starter
# For local development with SQLite (default if not set):
# Leave DATABASE_URL unset or comment out
DATABASE_URL=

# Redis
# For local development:
REDIS_URL=redis://localhost:6379/0
# Alternative Redis configuration (if REDIS_URL is not set):
REDISHOST=127.0.0.1
REDISPORT=6379
REDIS_DB=1
REDIS_DB_CELERY=0

# AWS S3 (for media file storage in production)
# Get credentials from AWS IAM console
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Stripe (for subscription management)
# Get keys from https://dashboard.stripe.com/apikeys
# Use test keys for development (sk_test_... and pk_test_...)
STRIPE_API_KEY=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
# Webhook secrets from https://dashboard.stripe.com/webhooks
STRIPE_ACCOUNT_WEBHOOK_SECRET=whsec_your_account_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret

# Email Configuration
# For development, emails will print to console (default)
# For production, configure your email provider:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
# For Gmail, create an app password: https://support.google.com/accounts/answer/185833

# reCAPTCHA (for bot protection)
# Get keys from https://www.google.com/recaptcha/admin
RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key
# Set to True to disable reCAPTCHA during development/testing
DISABLE_RECAPTCHA=False

# Sentry (optional - for error tracking)
# Get DSN from https://sentry.io/
SENTRY_DSN=

# Maintenance Mode
# Set to True to enable maintenance mode
# Note: Can also be toggled via Django admin
MAINTENANCE_MODE=False

# Feature Flags (optional)
# Add your custom feature flags here
# FEATURE_BETA_DASHBOARD=False
