# =============================================================================
# DJANGO SAAS STARTER - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure with your actual values
# NEVER commit .env file to version control!
# =============================================================================

# =============================================================================
# CORE DJANGO SETTINGS
# =============================================================================

# Environment: development, qa, production
# Controls which settings file is loaded (config.settings.{ENV})
ENV=development

# Secret key for cryptographic signing
# Generate a new one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Or: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-this-in-production-use-long-random-string

# Debug mode - MUST be False in production
DEBUG=True

# Allowed hosts - comma-separated list of domains
# Development: localhost,127.0.0.1
# Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Base URL for your application (used in emails and absolute URLs)
# Development: http://localhost:8000
# Production: https://yourdomain.com
BASE_URL=http://localhost:8000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL (supports PostgreSQL, MySQL, SQLite)
# Leave empty or comment out to use SQLite (default for development)
# PostgreSQL: postgresql://username:password@localhost:5432/dbname
# PostgreSQL with options: postgresql://user:pass@host:5432/db?sslmode=require
# MySQL: mysql://username:password@localhost:3306/dbname
# SQLite: sqlite:///path/to/db.sqlite3
DATABASE_URL=

# Example PostgreSQL configurations:
# Local PostgreSQL:
# DATABASE_URL=postgresql://saas_user:password@localhost:5432/django_saas_starter

# Heroku Postgres (automatically set by Heroku):
# DATABASE_URL=postgres://...

# AWS RDS PostgreSQL:
# DATABASE_URL=postgresql://admin:password@your-rds-endpoint.rds.amazonaws.com:5432/django_saas

# =============================================================================
# REDIS CONFIGURATION (for caching and Celery)
# =============================================================================

# Redis URL (preferred method)
# Local: redis://localhost:6379/0
# Redis Cloud: redis://username:password@host:port/0
# Heroku Redis (automatically set by Heroku): redis://...
REDIS_URL=redis://localhost:6379/0

# Alternative Redis configuration (used if REDIS_URL is not set)
REDISHOST=127.0.0.1
REDISPORT=6379
REDIS_DB=1
REDIS_DB_CELERY=0

# =============================================================================
# AWS S3 CONFIGURATION (for media file storage)
# =============================================================================
# Required for production, optional for development
# Get credentials from AWS IAM console: https://console.aws.amazon.com/iam/

# AWS Access Key ID
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=

# S3 Bucket name (must be globally unique)
AWS_STORAGE_BUCKET_NAME=

# S3 Region (e.g., us-east-1, us-west-2, eu-west-1)
AWS_S3_REGION_NAME=us-east-1

# Custom S3 domain (optional - for CloudFront CDN)
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# S3 File Overwrite (set to False to prevent overwriting files with same name)
# AWS_S3_FILE_OVERWRITE=False

# S3 Object Parameters (optional - for cache control)
# AWS_S3_OBJECT_PARAMETERS={'CacheControl': 'max-age=86400'}

# =============================================================================
# STRIPE CONFIGURATION (for subscription management)
# =============================================================================
# Get keys from: https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_..., pk_test_...) for development
# Use LIVE keys (sk_live_..., pk_live_...) for production

# Stripe Secret Key (for server-side API calls)
# Test: sk_test_...
# Live: sk_live_...
STRIPE_API_KEY=sk_test_your_test_secret_key_here

# Stripe Publishable Key (for client-side JavaScript)
# Test: pk_test_...
# Live: pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Stripe Webhook Signing Secrets
# Get from: https://dashboard.stripe.com/webhooks
# Account Webhook Secret (for main account webhooks)
STRIPE_ACCOUNT_WEBHOOK_SECRET=whsec_your_account_webhook_secret

# Connect Webhook Secret (for Stripe Connect webhooks - optional)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For development, emails print to console by default
# For production, configure your email provider

# Email Backend
# Development: django.core.mail.backends.console.EmailBackend
# Production (SMTP): django.core.mail.backends.smtp.EmailBackend
# Production (SendGrid): django.core.mail.backends.smtp.EmailBackend
# Production (AWS SES): django_ses.SESBackend (requires django-ses)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (Gmail example)
# For Gmail, create an app password: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMTP Settings (SendGrid example)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key

# Default From Email
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Server Email (for error notifications)
SERVER_EMAIL=errors@yourdomain.com

# Admin Email (comma-separated list)
# ADMINS=Admin Name,admin@yourdomain.com;Another Admin,admin2@yourdomain.com

# =============================================================================
# RECAPTCHA CONFIGURATION (for bot protection on signup)
# =============================================================================
# Get keys from: https://www.google.com/recaptcha/admin
# Use reCAPTCHA v2 Checkbox

# reCAPTCHA Site Key (visible in HTML)
RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key

# reCAPTCHA Secret Key (server-side validation)
RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key

# Disable reCAPTCHA (useful for development/testing)
# Set to True to bypass reCAPTCHA validation
DISABLE_RECAPTCHA=True

# =============================================================================
# SECURITY SETTINGS (Production Only)
# =============================================================================
# These should be enabled in production for security

# Force HTTPS redirect (production only)
# SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Secure cookies (production only - requires HTTPS)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# ERROR TRACKING (Optional - Sentry)
# =============================================================================
# Get DSN from: https://sentry.io/
# Used for error monitoring and performance tracking

# Sentry DSN
SENTRY_DSN=

# Sentry Environment (matches ENV by default)
# SENTRY_ENVIRONMENT=production

# Sentry Traces Sample Rate (0.0 to 1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# CELERY CONFIGURATION (Optional - for background tasks)
# =============================================================================
# Celery uses Redis as message broker (REDIS_URL)

# Celery Broker URL (defaults to REDIS_URL if not set)
# CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery Task Time Limit (seconds)
# CELERY_TASK_TIME_LIMIT=300

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
# Enable/disable maintenance mode
# Can also be toggled via Django admin or management command:
# python manage.py maintenance_mode --enable

MAINTENANCE_MODE=False

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Django Debug Toolbar (only works when DEBUG=True)
# Set to True to enable Django Debug Toolbar
# ENABLE_DEBUG_TOOLBAR=False

# =============================================================================
# INTERNATIONALIZATION
# =============================================================================

# Default Language
# LANGUAGE_CODE=en-us

# Time Zone
# TIME_ZONE=UTC

# =============================================================================
# RATE LIMITING
# =============================================================================
# django-ratelimit configuration

# Enable/disable rate limiting
# ENABLE_RATE_LIMITING=True

# =============================================================================
# CUSTOM FEATURE FLAGS (Optional)
# =============================================================================
# Add your custom feature flags here

# Example feature flags:
# FEATURE_BETA_DASHBOARD=False
# FEATURE_ADVANCED_ANALYTICS=False
# FEATURE_MULTI_LANGUAGE=True

# =============================================================================
# DEVELOPMENT/TESTING OVERRIDES
# =============================================================================

# Disable collectstatic during deployment (Heroku)
# DISABLE_COLLECTSTATIC=1

# =============================================================================
# NOTES
# =============================================================================
# 1. Always use strong, unique SECRET_KEY in production
# 2. Set DEBUG=False in production
# 3. Use environment-specific .env files (.env.production, .env.qa)
# 4. Never commit .env files to version control
# 5. Use test Stripe keys for development, live keys for production
# 6. Enable all security settings in production
# 7. Configure proper email backend for production
# 8. Set up S3 for media files in production
# 9. Configure Redis for caching and Celery
# 10. Set up Sentry or similar for error tracking
# =============================================================================
